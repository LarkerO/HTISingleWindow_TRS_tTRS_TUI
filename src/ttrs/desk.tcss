Screen { background: #101923; color: #d9e2ec; }
#identity { height: 2; padding: 0 1; color: #76d7db; text-style: bold; }
#menubar, #actions { height: 3; padding: 0 1; }
Button {
    min-width: 10; height: 3; border: solid #526779; background: #162535;
    color: #e3eaf2; padding: 0 1; margin-right: 1;
}
Button:focus { border: solid #5fdaeb; background: #215b86; text-style: bold; }
Button:hover { background: #24415a; }
#fields { height: 6; padding: 0 1; }
#fields Vertical { height: 6; margin-right: 1; }
#fields Static { height: 1; color: #76d7db; }
.date-field { width: 17; }
.train-field { width: 17; }
.station-field { width: 1fr; min-width: 16; }
#fields Button { width: 100%; margin-right: 0; }
Input { height: 3; border: solid #526779; background: #111e2b; }
Input:focus { border: solid #5fdaeb; }
#journey-panel, #queue-panel {
    border: solid #526779; margin: 0 1; height: 1fr; min-height: 5;
    border-title-color: #76d7db;
}
DataTable { height: 1fr; background: #101923; }
DataTable > .datatable--header { background: #203448; color: #76d7db; text-style: bold; }
DataTable > .datatable--cursor { background: #215b86; color: #ffffff; }
#totals { height: 2; padding: 0 1; color: #f0cb74; }
#key-hints { height: 1; padding: 0 1; color: #9fb5c8; }
#status { height: 4; padding: 0 1; color: #76d7db; border-top: solid #526779; }
ModalScreen { align: center middle; background: #000000 65%; }
#dialog {
    width: 84%; max-width: 110; height: auto; max-height: 92%;
    border: solid #76d7db; background: #142131; padding: 1 2;
}
.dialog-title { height: 2; color: #76d7db; text-style: bold; }
.form-fields { height: auto; max-height: 25; }
.form-fields Label { height: 1; color: #b6c8d8; }
.message-body { height: auto; max-height: 24; margin-bottom: 1; }
.dialog-actions { height: 3; margin-top: 1; }
#choices { height: auto; max-height: 22; margin-bottom: 1; }
ListItem { height: 2; padding: 0 1; }
#station-results { height: 14; }
.ascii #dialog, .ascii Button, .ascii Input { border: ascii #64748b; }

Screen.compact #identity { height: 2; }
Screen.compact #key-hints { display: none; }
Screen.compact #fields, Screen.compact #fields Vertical { height: 4; }
Screen.compact #fields .date-field { width: 14; }
Screen.compact #fields .train-field { width: 12; }
Screen.compact #fields .station-field { min-width: 10; margin-right: 0; }
Screen.compact #fields Button { min-width: 6; padding: 0; }
Screen.compact #menubar Button, Screen.compact #actions Button { width: 1fr; min-width: 6; padding: 0; margin-right: 0; }
Screen.compact #journey-panel, Screen.compact #queue-panel { min-height: 4; }
Screen.compact #totals { height: 1; }

#mode-status { height: 1; padding: 0 1; color: #f0cb74; }

.receipt-dialog #dialog, .long-message #dialog, .tall-form #dialog { height: 90%; }
.receipt-dialog .message-body, .long-message .message-body, .tall-form .form-fields { height: 1fr; max-height: 100%; min-height: 1; }

.ascii #journey-panel, .ascii #queue-panel { border: ascii #64748b; }
.ascii #status { border-top: ascii #526779; }
Screen.compact #menubar { height: 1; }
Screen.compact #menubar Button { height: 1; border: none; }
